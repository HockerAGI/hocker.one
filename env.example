# HOCKER ONE — Environment Contract
# Consolidated from env.example + env.example.enhanced
# Every variable referenced by the runtime is listed here.
#
# ══════════════════════════════════════════════════════════════
#  NAMING CONVENTION (PR-07 Env Key Consistency)
# ══════════════════════════════════════════════════════════════
#  • New keys use HOCKER_ prefix for platform-wide secrets
#  • Legacy keys (without HOCKER_ prefix) are still read as
#    fallbacks — do NOT remove them until a full migration pass.
#  • NEXT_PUBLIC_ keys are exposed to the browser bundle.
#  • MCP_ keys are URL endpoints for Model Context Protocol.
#
#  LEGACY → NEW MAPPING:
#    COMMAND_HMAC_SECRET           → HOCKER_COMMAND_HMAC_SECRET
#    SUPABASE_SERVICE_ROLE_KEY     → SUPABASE_SECRET_KEY
#    SUPABASE_ANON_KEY             → NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (browser)
#    GITHUB_TOKEN                  → HOCKER_GITHUB_TOKEN
#    GH_TOKEN                     → HOCKER_GITHUB_TOKEN
#    WORKSPACE_ROOT                → HOCKER_WORKSPACE_ROOT
#    CRON_SECRET                   → HOCKER_ONE_INTERNAL_TOKEN
# ══════════════════════════════════════════════════════════════

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # Preferred browser/mobile key
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # Legacy browser fallback
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=             # Legacy — use SUPABASE_SECRET_KEY instead
SUPABASE_PUBLISHABLE_KEY=              # Server/Edge publishable key when not public
SUPABASE_SECRET_KEY=                   # @supabase/server v1.3.0 secret key (replaces SERVICE_ROLE_KEY)
SUPABASE_JWKS_URL=                     # JWKS endpoint for JWT validation

# === NOVA / Orchestration ===
NOVA_AGI_URL=__SET_AFTER_DEPLOY__
NOVA_AGI_HEALTH_URL=__SET_AFTER_DEPLOY__
NOVA_API_KEY=
NOVA_ORCHESTRATOR_KEY=
NOVA_COMMAND_HMAC_SECRET=
NOVA_EXPOSE_INTERNAL_META=
NOVA_SURVIVAL_MODE_ENABLED=0
NOVA_SURVIVAL_REPLY=Modo de supervivencia activo.
ORCHESTRATOR_BASE_URL=__SET_AFTER_DEPLOY__

# === Hocker Core ===
HOCKER_AUDIT_SECRET=
HOCKER_COMMAND_HMAC_SECRET=
COMMAND_HMAC_SECRET=                 # Legacy fallback → HOCKER_COMMAND_HMAC_SECRET
CHIDO_ACTION_HMAC_SECRET=
HOCKER_ONE_INTERNAL_TOKEN=
CRON_SECRET=                         # Legacy fallback → HOCKER_ONE_INTERNAL_TOKEN
HOCKER_OWNER_ACTION_KEY=
HOCKER_WORKSPACE_ROOT=
WORKSPACE_ROOT=                      # Legacy fallback → HOCKER_WORKSPACE_ROOT
ALLOW_LOCAL_COMMANDS=0
ALLOW_WRITE_COMMANDS=0
DIAGNOSTIC_ROUTES=

# === Node / Project Identity ===
DEFAULT_PROJECT_ID=
DEFAULT_NODE_ID=
DEFAULT_COMMAND_NODE_ID=
HOCKER_DEFAULT_NODE_ID=
HOCKER_PROJECT_ID=
HOCKER_ONE_DEFAULT_ROLE=viewer
HOCKER_ONE_PUBLIC_URL=__SET_AFTER_DEPLOY__
CLOUD_COMMAND_NODE_ID=
HOCKER_LOCAL_AGENT_NODE_ID=
HOCKER_MIRROR_AGENT_NODE_ID=
HOCKER_PHYSICAL_AGENT_NODE_ID=
HOCKER_PRIMARY_AGENT_NODE_ID

# === GitHub / Worker ===
HOCKER_GITHUB_TOKEN=                # Preferred — used by MCP + worker
GITHUB_TOKEN=                       # Legacy fallback → HOCKER_GITHUB_TOKEN
GH_TOKEN=                           # Legacy fallback → HOCKER_GITHUB_TOKEN
GITHUB_OWNER=HockerAGI
GITHUB_REPO=hocker.one
GITHUB_DEFAULT_BRANCH=main
GITHUB_REPOSITORY=
GITHUB_REF_NAME=
