{
  "name": "hocker.one",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:debug": "cap run android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:aab": "cd android && ./gradlew bundleRelease",
    "android:sync:web": "npm run build && cap sync android",
    "diagnostics:router": "node scripts/diagnostics/hocker-diagnostics-provider-router.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.3.1",
    "@capacitor/core": "8.3.1",
    "@supabase/server": "^1.3.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "@trigger.dev/sdk": "4.5.4",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "iconv-lite": "^0.7.2",
    "langfuse-node": "^3.38.6",
    "lucide-react": "^0.451.0",
    "next": "16.2.12",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.15.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.3",
    "sonner": "^2.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.3.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "@types/node": "^22.13.1",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0"
  }
}
