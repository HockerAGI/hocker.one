{
  "name": "hocker.one",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "lint": "eslint . --quiet",
    "lint:all": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:debug": "cap run android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:aab": "cd android && ./gradlew bundleRelease",
    "android:sync:web": "npm run build && cap sync android",
    "diagnostics:router": "node scripts/diagnostics/hocker-diagnostics-provider-router.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.3.1",
    "@capacitor/core": "8.3.1",
    "@supabase/server": "^1.3.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "iconv-lite": "^0.7.2",
    "langfuse-node": "3.38.20",
    "lucide-react": "^1.30.0",
    "next": "16.2.12",
    "node-cron": "^4.2.1",
    "pdfkit": "0.19.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "sonner": "^2.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.3.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "@types/node": "^22.13.1",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "0.17.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.0",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "axios": "1.18.1",
    "brace-expansion": "1.1.18",
    "fast-uri": "3.1.4",
    "form-data": "4.0.6",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "ws": "8.21.1"
  }
